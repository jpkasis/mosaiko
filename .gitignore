# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Live Shopify secrets (Client ID/Secret, transitional admin token, variant GIDs)
ShopifyValues.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product image backups
public/products/_originals/

# dev-mode cart-composite blob cache (filesystem-backed; survives dev-server
# restart so cart thumbnails remain valid). Production uses R2; this dir is
# only written when R2 is unreachable.
/.cart-composite-cache/

# Local source assets — inputs to one-off generation scripts (e.g. make-favicon
# reads MOSAIKO-logos/). The generated favicons + the public/ product images are
# committed; these large source dirs stay local.
MOSAIKO-images/
MOSAIKO-logos/
mosaic-categories/

# Local scratch — Codex audit logs/prompts, UAT simulation artifacts, thumbnail
# spikes. Never part of the build.
.codex-*
.uat4-*
.brand-*.png
